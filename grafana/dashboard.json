      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Ready pods by version + color",
          "description": "Which pod versions are currently in the ready pool. During a blue/green promotion you'll see the new version pop up here alongside the old one, then the old one drop out after scaleDownDelaySeconds.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "${DS_PROMETHEUS}"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "app_ready{job=~\"$job\"} * on(instance) group_left(version, color) app_info",
                        "format": "table",
                        "instant": true,
                        "legendFormat": "__auto",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.2.1",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {
                          "text": "not ready",
                          "color": "red",
                          "index": 0
                        },
                        "1": {
                          "text": "ready",
                          "color": "green",
                          "index": 1
                        }
                      }
                    }
                  ],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      }
                    ]
                  },
                  "color": {
                    "mode": "palette-classic"
